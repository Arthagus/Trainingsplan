# Vorlage fuer .env — kopieren, ausfuellen, niemals committen (.env ist gitignored).
#   cp .env.example .env

# Secret ausschliesslich fuer den Hash des Remember-Me-Validators (§5).
# KEIN Passwort-Pepper: die Passwort-Hashes bleiben von diesem Wert unberuehrt.
# Erzeugen mit:  openssl rand -hex 32
APP_SECRET=

# Erst-Admin, nur beim allerersten Start ausgewertet (Bootstrapping, §3).
# Der Benutzer wird mit must_change_password = 1 angelegt und muss das Passwort
# beim ersten Login aendern. Spaetere Aenderungen hier wirken nicht mehr.
ADMIN_USER=admin
ADMIN_PASSWORD=

TZ=Europe/Vienna

# --- Deployment im LXC 10.10.10.2 (Proxmox) ----------------------------------
# BIND_ADDR ist die IP des LXC im Proxmox-Internetz. Niemals 0.0.0.0 eintragen:
# die Vertrauenswuerdigkeit von X-Forwarded-Proto haengt daran, dass der Port
# nur ueber den vorgelagerten Nginx erreichbar ist.
BIND_ADDR=10.10.10.2
HOST_PORT=8066

# Fuer die Datenablage gibt es hier bewusst nichts einzustellen: Datenbank und
# Uploads liegen in Named Volumes (trainingsplan-data, trainingsplan-uploads),
# die Docker selbst verwaltet. Keine Host-Pfade anzulegen, keine Rechte zu
# setzen. In Portainer sind sie unter "Volumes" sichtbar.
